# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed. Every value has a sensible
# default in backend/config.py, so `.env` is entirely optional.
#
# NEVER put personal data, resume content or real secrets in this file.
# `.env` is git-ignored; `.env.example` is committed.
# ---------------------------------------------------------------------------

# --- Embedding model ---
# Any sentence-transformers model id. Larger models are more accurate but
# slower and heavier. all-MiniLM-L6-v2 is ~80 MB and runs fine on a CPU.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Document chunking ---
# The model only reads ~256 word-pieces at a time, so long documents are split
# into overlapping word windows and the chunk vectors are averaged.
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=30

# --- Score weighting ---
# overall = SEMANTIC_WEIGHT * cosine_similarity + SKILL_WEIGHT * skill_coverage
# These are a readability choice, not values learned from hiring data.
SEMANTIC_WEIGHT=0.7
SKILL_WEIGHT=0.3

# Cosine threshold above which a "missing" skill is reported as
# semantically related to some passage of the resume.
SEMANTIC_SKILL_THRESHOLD=0.45

# --- Upload limits ---
MAX_UPLOAD_MB=5
MIN_EXTRACTED_CHARS=50

# --- Server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Frontend -> backend ---
# Read by frontend/app.py to locate the API.
API_BASE_URL=http://127.0.0.1:8000
